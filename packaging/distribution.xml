<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Cold Turkey Guardian (dev, unsigned)</title>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.coldturkeyguardian.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.coldturkeyguardian.pkg" visible="false">
        <pkg-ref id="com.coldturkeyguardian.pkg"/>
    </choice>
    <pkg-ref id="com.coldturkeyguardian.pkg" version="0.1.0" onConclusion="none">guardian-dev-component.pkg</pkg-ref>
</installer-gui-script>
